{
  "version": 2,
  "builds": [
    {
      "src": "./index.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/services/(.*)",
      "dest": "services/dataService.js"
    },
    {
      "src": "/(.*)",
      "dest": "services/dataService.js"
    }
  ],
  "env": {
    "NODE_ENV": "production"
  }
}
